# LimaBlocks configuration template.
#
#   cp .env.example .env
#
# .env is git-ignored: it is the only place secrets and machine-specific values
# belong. Docker Compose reads it automatically (both to substitute ${VAR} in
# docker-compose.yml and to hand the values to the containers), and the Django
# settings module reads it too, so `python manage.py runserver` outside Docker
# sees exactly the same configuration.
#
# Every value below is optional; the defaults shown are what the code falls back
# to when the variable is missing.

###############################################################################
# Django
###############################################################################

# SECURITY WARNING: keep this secret. Required whenever DJANGO_DEBUG is off.
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Wrap it in single quotes: an unquoted '$' would be read as a variable
# reference by both Docker Compose and python-dotenv.
DJANGO_SECRET_KEY=''

# SECURITY WARNING: never leave this on in production.
DJANGO_DEBUG=True

# Comma separated. Empty means Django serves localhost only (DEBUG behaviour).
# "api" is the compose service name, so containers can reach the backend by it.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],api,0.0.0.0

DJANGO_LANGUAGE_CODE=en-us
DJANGO_TIME_ZONE=UTC

###############################################################################
# Ports and public addresses
###############################################################################
# Both services listen on and are published at these ports, so changing one
# value here moves the port everywhere: the container, the host mapping, the
# healthcheck and the CORS origin.

BACKEND_URL=http://localhost
BACKEND_PORT=8000

FRONTEND_URL=http://localhost
FRONTEND_PORT=3000

# Extra browser origins allowed to call the API, comma separated. The frontend's
# own origin (FRONTEND_URL:FRONTEND_PORT) is always allowed on top of these.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

###############################################################################
# Database
###############################################################################
# Defaults to the bundled SQLite file. For a server database, set DB_ENGINE to
# e.g. django.db.backends.postgresql or mssql, then fill in the rest.

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

###############################################################################
# Uploaded / generated files
###############################################################################
# MEDIA_ROOT is relative to lima-backend/limaBackend/ unless given as an
# absolute path.

MEDIA_URL=/media/
MEDIA_ROOT=media

###############################################################################
# Frontend (Create React App)
###############################################################################
# Only REACT_APP_* names reach the browser bundle, and they are read at build /
# dev-server start time - restart the web container after changing them.
# These are resolved by the browser, so they must point at the published host
# ports, not at the compose service names.
# NOTE: anything here ships to the browser in cleartext. Never put a secret in a
# REACT_APP_* variable.

REACT_APP_API_ROOT=http://127.0.0.1:8000/api/
REACT_APP_CLIENT_ROOT=http://localhost:3000
