# Frontend configuration for running the dev server directly (`npm start`)
# instead of through Docker Compose:
#
#   cp .env.example .env
#
# Under Compose these same values come from the repo-root .env, so this file is
# only needed for a bare `npm start`. Keep the two in sync.
#
# Create React App only exposes REACT_APP_* names to the bundle, and it reads
# them when the dev server starts - restart it after editing.
# NOTE: everything here is shipped to the browser in cleartext. Never put a
# secret, key or password in a REACT_APP_* variable.

# Where the browser reaches the Django API (published host port, not the
# compose service name).
REACT_APP_API_ROOT=http://127.0.0.1:8000/api/

# This app's own public address.
REACT_APP_CLIENT_ROOT=http://localhost:3000

# Port the dev server listens on. Must match FRONTEND_PORT in the root .env.
PORT=3000
